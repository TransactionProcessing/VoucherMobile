<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:VoucherMobile.BusinessLogic.ViewModels;assembly=VoucherMobile.BusinessLogic"
             x:Class="VoucherMobile.App.Pages.LoginPage"
             x:DataType="viewModels:LoginPageViewModel"
             Title="Login"
             Shell.NavBarIsVisible="False"
             Padding="0">
    <ContentPage.Content>
        <Grid>
            <BoxView>
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{DynamicResource primary}" Offset="0.0" />
                        <GradientStop Color="{DynamicResource brandGradientEndColor}" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <ScrollView InputTransparent="{Binding IsBusy}">
                <VerticalStackLayout Spacing="0">
                    <VerticalStackLayout HorizontalOptions="Center"
                                         Spacing="10"
                                         Padding="20,80,20,40">
                        <Image Source="headerlogo.svg"
                               Style="{StaticResource LoginImage}"
                               HeightRequest="150"
                               WidthRequest="150"
                               HorizontalOptions="Center" />
                        <Label Text="Voucher Mobile"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center" />
                        <Label Text="Sign in to continue"
                               FontSize="14"
                               TextColor="White"
                               Opacity="0.75"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <Frame CornerRadius="30"
                           Padding="30,30,30,40"
                           HasShadow="True"
                           BackgroundColor="{DynamicResource cardBackgroundColor}"
                           Margin="20,0,20,20"
                           BorderColor="{DynamicResource cardBorderColor}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Username" Style="{StaticResource LoginFieldLabel}" />
                            <Frame Style="{StaticResource LoginEntryContainerFrame}">
                                <Entry Placeholder="Enter your username"
                                       AutomationId="UserNameEntry"
                                       Style="{StaticResource LoginEntryCardStyle}"
                                       Text="{Binding UserName}" />
                            </Frame>

                            <Label Text="Password"
                                   Style="{StaticResource LoginFieldLabel}"
                                   Margin="0,12,0,0" />
                            <Frame Style="{StaticResource LoginEntryContainerFrame}">
                                <Entry Placeholder="Enter your password"
                                       AutomationId="PasswordEntry"
                                       IsPassword="True"
                                       Style="{StaticResource LoginEntryCardStyle}"
                                       Text="{Binding Password}" />
                            </Frame>

                            <Label Text="Use demo credentials: demo / Password123!"
                                   FontSize="12"
                                   TextColor="{DynamicResource Gray400}"
                                   Margin="0,12,0,0" />

                            <Label Text="{Binding StatusMessage}"
                                   FontSize="13"
                                   TextColor="{DynamicResource errorTextColor}"
                                   IsVisible="{Binding HasStatusMessage}"
                                   AutomationId="LoginStatusMessage" />

                            <Button Text="Sign In"
                                    Style="{StaticResource LoginButton}"
                                    Command="{Binding LogonCommand}"
                                    AutomationId="LoginButton"
                                    Margin="0,8,0,0" />
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>
            </ScrollView>

            <Grid IsVisible="{Binding IsBusy}"
                  BackgroundColor="#66000000"
                  InputTransparent="False">
                <Frame HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Padding="24"
                       CornerRadius="18"
                       BackgroundColor="#CC1F2A44"
                       BorderColor="#00FFFFFF">
                    <VerticalStackLayout Spacing="12">
                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           Color="White"
                                           HorizontalOptions="Center" />
                        <Label Text="Signing in..."
                               TextColor="White"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Frame>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
