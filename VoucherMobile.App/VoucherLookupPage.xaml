<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VoucherMobile.App.VoucherLookupPage"
             Title="Voucher Lookup">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Voucher Lookup"
                   FontSize="28"
                   FontAttributes="Bold"
                   SemanticProperties.HeadingLevel="Level1" />

            <Frame Padding="12" BorderColor="LightGray">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Scan / Enter Voucher" FontAttributes="Bold" />
                    <Entry Placeholder="Voucher Code" Text="{Binding Redemption.VoucherCode}" />
                    <Button Text="Load Voucher" Clicked="OnLoadVoucherClicked" />
                    <Label Text="{Binding Redemption.StatusMessage}" FontSize="12" />
                    <Label Text="{Binding Redemption.CurrentVoucher.VoucherCode, StringFormat='Code: {0}'}" />
                    <Label Text="{Binding Redemption.CurrentVoucher.RemainingBalance, StringFormat='Remaining: {0:0.00}'}" />
                    <Label Text="{Binding Redemption.CurrentVoucher.ExpiryDateUtc, StringFormat='Expiry (UTC): {0:yyyy-MM-dd HH:mm}'}" />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
